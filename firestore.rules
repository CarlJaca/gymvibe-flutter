rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════

    /// Returns true if the request is from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Returns true if the authenticated user's UID matches the given userId.
    function isOwnerOf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /// Returns true if a string field is present and within length bounds.
    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    /// Returns true if the authenticated user has isOwner == true in their profile.
    function isGymOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true;
    }

    /// Returns true if the authenticated user has the super_admin role.
    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    /// Returns true if the authenticated user owns the gym with the given id.
    function isGymOwnerOfBookingGym(gymId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/gyms/$(gymId)) &&
        get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Users Collection
    // ═══════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Any authenticated user can view public user profiles (for reviews, comments, community)
      allow read: if isAuthenticated();

      // Users can create their own profile during registration
      allow create: if isOwnerOf(userId)
        && isValidString(request.resource.data.name, 2, 50)
        && isValidString(request.resource.data.email, 5, 254);

      // Users can update their own profile but cannot self-promote to owner
      allow update: if isOwnerOf(userId)
        && request.resource.data.isOwner == resource.data.isOwner;

      // Users cannot delete their own profile (admin-only operation)
      allow delete: if false;

      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated();
      }

      // User's personal workout calendar
      match /workoutCalendar/{dateKey} {
        allow read, write: if isOwnerOf(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // Gyms Collection
    // ═══════════════════════════════════════════════════════════════════

    match /gyms/{gymId} {
      // Anyone authenticated can read gym listings
      allow read: if isAuthenticated();

      // Only gym owners can create a gym, and must set themselves as ownerId
      allow create: if isGymOwner()
        && request.resource.data.ownerId == request.auth.uid
        && isValidString(request.resource.data.name, 2, 100);

      // Gym owners can update their gym; authenticated users can submit reviews / ratings
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviews', 'rating', 'reviewCount'])
      );

      // Only the gym's owner can delete it
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      // Personal Records / Leaderboard under a gym
      match /personalRecords/{recordId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // Bookings Collection
    // ═══════════════════════════════════════════════════════════════════

    match /bookings/{bookingId} {
      // Users can read all bookings (needed for crowd status calculation)
      allow read: if isAuthenticated();

      // Users can create bookings for themselves only.
      // A new booking can never start out as Verified/Rejected.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (!('paymentStatus' in request.resource.data)
            || request.resource.data.paymentStatus == 'Pending');

      // Booking owner can update (e.g., cancel) but can NOT touch paymentStatus.
      // The gym owner of the booking's gym can ONLY change paymentStatus
      // (Verified / Rejected / Pending). Super admins are covered by global rule.
      allow update: if isAuthenticated() && (
        (
          resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['paymentStatus'])
        )
        ||
        (
          isGymOwnerOfBookingGym(resource.data.gymId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['paymentStatus'])
          && request.resource.data.paymentStatus in ['Pending', 'Verified', 'Rejected']
        )
        || isSuperAdmin()
      );

      // Only the booking owner can delete
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Events Collection
    // ═══════════════════════════════════════════════════════════════════

    match /events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Communities Collection
    // ═══════════════════════════════════════════════════════════════════

    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isGymOwner() || isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Posts Collection (Community Posts) & Comments
    // ═══════════════════════════════════════════════════════════════════

    match /posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Author can edit; other users can like/unlike or update comment counts
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['likedBy', 'likeCount', 'commentsCount'])
      );

      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // Promotions Collection
    // ═══════════════════════════════════════════════════════════════════

    match /promotions/{promotionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isGymOwner() || isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Job Postings (supports both camelCase and snake_case)
    // ═══════════════════════════════════════════════════════════════════

    match /jobPostings/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isGymOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /job_postings/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isGymOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Job Applications (supports both camelCase and snake_case)
    // ═══════════════════════════════════════════════════════════════════

    match /jobApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated() 
        && request.resource.data.applicantId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAuthenticated() 
        && resource.data.applicantId == request.auth.uid;

      match /statusHistory/{historyId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /job_applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated() 
        && request.resource.data.applicantId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAuthenticated() 
        && resource.data.applicantId == request.auth.uid;

      match /statusHistory/{historyId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // Content Reports & Moderation
    // ═══════════════════════════════════════════════════════════════════

    match /contentReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Admin Notifications & App Settings & Audit Logs
    // ═══════════════════════════════════════════════════════════════════

    match /adminNotifications/{notifId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Global Admin Access
    // ═══════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
